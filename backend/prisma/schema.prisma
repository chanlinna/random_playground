// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(100)
  identity              String                 @db.VarChar(255)
  description           String?                @db.Text
  population            Int?
  capital               String?                @db.VarChar(100)
  currency              String?                @db.VarChar(100)
  nationalAnimal        String?                @map("national_animal") @db.VarChar(100)
  nationalFood          String?                @map("national_food") @db.VarChar(100)
  foundedYear           Int?                   @map("founded_year")
  governmentType        String?                @map("government_type") @db.VarChar(100)
  mostPopularProfession String?                @map("most_popular_profession") @db.VarChar(100)
  mostCommonHobby       String?                @map("most_common_hobby") @db.VarChar(100)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  characteristics       CountryCharacteristic[]

  @@map("countries")
}

model Characteristic {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique @db.VarChar(100)
  description           String?                @db.Text
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  countries             CountryCharacteristic[]
  optionCharacteristics OptionCharacteristic[]

  @@map("characteristics")
}

model CountryCharacteristic {
  id               Int           @id @default(autoincrement())
  countryId        Int           @map("country_id")
  characteristicId Int           @map("characteristic_id")
  strength         Int           @default(0)

  country           Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  characteristic    Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@unique([countryId, characteristicId])
  @@map("country_characteristics")
}

model Question {
  id           Int              @id @default(autoincrement())
  questionText String           @map("question_text") @db.Text
  questionType String           @map("question_type") @db.VarChar(50)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  options      QuestionOption[]

  @@map("questions")
}

model QuestionOption {
  id               Int                    @id @default(autoincrement())
  questionId       Int                    @map("question_id")
  optionText       String                 @map("option_text") @db.VarChar(255)
  displayOrder     Int                    @default(0) @map("display_order")
  createdAt        DateTime               @default(now()) @map("created_at")

  question         Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  characteristics  OptionCharacteristic[]

  @@map("question_options")
}

model OptionCharacteristic {
  id               Int             @id @default(autoincrement())
  optionId         Int             @map("option_id")
  characteristicId Int             @map("characteristic_id")
  weight           Int             @default(0)

  option           QuestionOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  characteristic   Characteristic  @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@unique([optionId, characteristicId])
  @@map("option_characteristics")
}